load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("//build/bazel_mgk_rules:mgk_ko.bzl", "define_mgk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version",)
package(
    default_visibility = [
        "//visibility:public",
    ],
)
mgk_imgsys_outs = [
    # keep sorted
    "mtk_imgsys_isp8s.ko",
]

filegroup(
    name = "public_headers",
    srcs = glob([
        "*.h",
        "**/*.h",
    ]),
)

filegroup(
    name = "kbuild_makefiles",
    srcs = [
        "Kbuild",
        "Makefile",
    ],
)

ddk_headers(
    name = "ddk_public_headers",
    includes = ["."],
    hdrs = glob(["**/*.h"]), # export all headers for other modules to use
)

# TODO: enable this part later
define_mgk_ko(
    name = "imgsys_8s",
    srcs = glob([
        "**/*.c",
        "**/*.h",
        "**/Kbuild",
        "**/Makefile",
    ]) + [
        "//vendor/mediatek/kernel_modules/mtkcam/mtk-hcp/isp8s:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/mtk-ipesys-me:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsys/common:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsys/imgsys/cmdq/isp8s:public_headers",
        "//vendor/mediatek/kernel_modules/mtkcam/mtk-hcp/isp8s:kbuild_makefiles",
        "//vendor/mediatek/kernel_modules/mtkcam/mtk-ipesys-me:kbuild_makefiles",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsys/common:kbuild_makefiles",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsys/imgsys/cmdq/isp8s:kbuild_makefiles",
    ],

    deps = [
        "//vendor/mediatek/kernel_modules/mtkcam/mtk-hcp/isp8s:mtk-hcp-isp8s",
        "//vendor/mediatek/kernel_modules/mtkcam/mtk-ipesys-me:mtk-ipesys-me",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsys/common:imgsys_common",
        "//vendor/mediatek/kernel_modules/mtkcam/imgsys/imgsys/cmdq/isp8s:imgsys_cmdq_isp8s",
        "//kernel_device_modules-{}/drivers/misc/mediatek/vmm:mtk-vmm-notifier-mt6993".format(kernel_version),
    ],

    outs = mgk_imgsys_outs,
)
